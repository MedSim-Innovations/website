generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model subscriptions {
  id    Int    @id @default(autoincrement())
  email String @unique
  name  String
}

model contact_messages {
  id      Int     @id @default(autoincrement())
  name    String
  email   String
  phone   String?
  subject String
  message String
}
