{
  "name": "website",
  "version": "0.0.0",
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "syncpack": "^15.3.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "private": true,
  "scripts": {
    "build": "next build",
    "deps:check": "syncpack lint --dependency-types prod,dev",
    "deps:fix": "syncpack fix --dependency-types prod,dev",
    "deps:patch": "syncpack update --interactive --target patch",
    "deps:update": "syncpack update --interactive",
    "dev": "next dev",
    "format:check": "syncpack format --check",
    "format:fix": "syncpack format",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "show:deps": "syncpack list --show all",
    "start": "next start"
  }
}
